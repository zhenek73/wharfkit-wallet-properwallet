{
  "name": "wharfkit-wallet-properwallet",
  "version": "0.1.0",
  "description": "ProperWallet plugin for WharfKit SessionKit.",
  "license": "MIT",
  "homepage": "https://github.com/zhenek73/wharfkit-wallet-properwallet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhenek73/wharfkit-wallet-properwallet.git"
  },
  "bugs": {
    "url": "https://github.com/zhenek73/wharfkit-wallet-properwallet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wharfkit",
    "wallet",
    "plugin",
    "eos",
    "vaulta",
    "properwallet"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir lib",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@wharfkit/session": "^1.4.0 || ^1.5.0 || ^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@wharfkit/session": "^1.6.1",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5"
  }
}
